/// Immutable 078 historical snapshot. Current identity is CandidateProfile.
model HistoricalStudentProfile {
  id         String   @id @default(cuid())
  legacyId   String   @unique
  userId     String
  snapshot   Json
  createdAt  DateTime
  archivedAt DateTime @default(now())

  @@index([userId])
}
