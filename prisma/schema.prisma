generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserType {
  STUDENT
  PROFESSIONAL
}

enum Domain {
  SE
  DS
  AI
  CLAUDE
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Challenge {
  id          String      @id @default(cuid())
  domain      Domain      @unique
  title       String
  description String
  totalDays   Int         @default(60)
  isActive    Boolean     @default(true)
  /**
   * When set, challenge days are synchronized from this IST calendar anchor (e.g. Claude cohort). Null = rolling start from enrollment.startedAt.
   */
  startsAt    DateTime?
  createdAt   DateTime    @default(now())
  dailyTasks  DailyTask[]
  quizzes     Quiz[]
}

model DailyTask {
  id                 String    @id @default(cuid())
  challengeId        String
  dayNumber          Int
  domain             Domain
  title              String
  problemStatement   String
  learningObjectives String[]  @default([])
  resources          String[]  @default([])
  difficulty         String
  estimatedMinutes   Int
  linkedinTemplate   String
  solutionApproach   String?
  tags               String[]  @default([])
  dayContent         Json?
  createdAt          DateTime  @default(now())
  challenge          Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, dayNumber])
  @@index([domain, dayNumber])
}

model Quiz {
  id            String         @id @default(cuid())
  challengeId   String
  domain        Domain
  weekNumber    Int
  title         String
  createdAt     DateTime       @default(now())
  challenge     Challenge      @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  quizQuestions QuizQuestion[]

  @@unique([challengeId, weekNumber])
}

model QuizQuestion {
  id            String @id @default(cuid())
  quizId        String
  questionOrder Int
  questionText  String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String
  quiz          Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, questionOrder])
}

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referredId  String   @unique
  rewardGiven Boolean  @default(false)
  createdAt   DateTime @default(now())
  referred    User     @relation("Referral_referredIdToUser", fields: [referredId], references: [id], onDelete: Cascade)
  referrer    User     @relation("Referral_referrerIdToUser", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model College {
  id         String   @id @default(cuid())
  /// upper(alnum(name)) + "|" + upper(alnum(district)) — dedupe + idempotent seed
  nameKey    String   @unique
  name       String
  state      String?
  district   String?
  city       String?
  /// Common names and acronyms students type ("IIT Bombay", "IITB").
  aliases    String[] @default([])
  /// 1 = top-of-mind, 2 = well-known, 3 = everything else. Primary search sort.
  tier       Int      @default(3)
  /// Space-padded, uppercased, alphanumeric-only haystack. See seed script.
  searchText String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model User {
  id                          String                       @id @default(cuid())
  email                       String                       @unique
  emailVerified               DateTime?
  name                        String?
  image                       String?
  /// scrypt hash from `src/lib/password.ts` (`scrypt$…`). Any other value —
  /// e.g. an old plain-text dev seed — is treated as "no password" and never
  /// compared.
  password                    String?
  role                        Role                         @default(STUDENT)
  /// Soft delete. Set instead of DELETE; PII is scrubbed by the anonymizer.
  deletedAt                   DateTime?
  anonymizedAt                DateTime?
  /// T-254 first-touch UTM attribution. Captured on the landing page from
  /// URL query, persisted to a cookie, then written here on signup finalise.
  /// First touch wins — later visits do not overwrite. Bounded free strings
  /// with a 200-char max at the write boundary (validations/utm.ts). Never
  /// sent to analytics as raw values; only campaign-level aggregates count.
  utmSource                   String?
  utmMedium                   String?
  utmCampaign                 String?
  utmTerm                     String?
  utmContent                  String?
  utmCapturedAt               DateTime?
  /// T-272 reversible operator freeze. Distinct from deletedAt (plan 119).
  disabledAt                  DateTime?
  disabledReason              String?
  disabledByUserId            String?
  /// JWT iat older than this is rejected. Set on disable and on secure.
  sessionInvalidatedAt        DateTime?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  accounts                    Account[]
  adminActionsPerformed       AdminAction[]                @relation("AdminActor")
  adminActionsReceived        AdminAction[]                @relation("AdminTarget")
  referredBy                  Referral?                    @relation("Referral_referredIdToUser")
  referralsMade               Referral[]                   @relation("Referral_referrerIdToUser")
  sessions                    Session[]
  phoneVerification           PhoneVerification?
  recruiterReview             RecruiterReview?
  jobApplications             JobApplication[]
  redemptions                 Redemption[]
  remarksReceived             AdminRemark[]                @relation("RemarkStudent")
  remarksAuthored             AdminRemark[]                @relation("RemarkAdmin")
  programEntryAttempts        ProgramEntryAttempt[]
  recruiterProfile            RecruiterProfile?
  shortlistItems              RecruiterShortlistItem[]
  hackathonParticipants       HackathonParticipant[]
  hackathonRemovals           HackathonRemoval[]           @relation("HackathonRemoved")
  hackathonVideoRegistrations HackathonVideoRegistration[] @relation("HackathonVideoRegistrant")
  newsletterSubscriptions     NewsletterSubscription[]
  workshopRegistrations       WorkshopRegistration[]
  legalConsents               LegalConsent[]
  dataRightsRequests          DataRightsRequest[]
  notificationReads           NotificationRead[]
  userNotifications           UserNotification[]           @relation("UserNotifications")
  notificationPreferences     NotificationPreference[]     @relation("NotificationPreferences")
  jobAlerts                   JobAlert[]                   @relation("CandidateJobAlerts")
  /// Interview platform attempts (plan 103). Direct User relation: a mock
  /// interview needs registration only, never cohort enrollment.
  mockInterviews              MockInterview[]

  // Canonical identity / learning / talent relations (078 complete).
  roleAssignments             UserRoleAssignment[]         @relation("RoleSubject")
  rolesGranted                UserRoleAssignment[]         @relation("RoleGranter")
  candidateProfile            CandidateProfile?
  campusAmbassadorApplication CampusAmbassadorApplication?
  visibility                  CandidateVisibility?
  resume                      CandidateResume?
  pointsAccount               PointsAccount?
  pointsLedger                PointsTransaction[]
  credentials                 Credential[]
  achievements                CandidateAchievement[]
  programEnrollments          ProgramEnrollment[]
  shortlistedAsCandidate      RecruiterShortlistItem[]     @relation("ShortlistCandidate")
  evaluationsGiven            ActivityEvaluation[]         @relation("Evaluator")
  orgMemberships              OrganizationMember[]
  talentListItems             TalentListItem[]
  candidateNotes              CandidateNote[]              @relation("NoteSubject")
  notesAuthored               CandidateNote[]              @relation("NoteAuthor")
  assessmentReports           AssessmentReport[]           @relation("AssessedCandidate")
  jobsCreated                 Job[]                        @relation("JobCreator")
  jobsOwned                   Job[]                        @relation("RecruiterJobs")
  recruitersApproved          RecruiterProfile[]           @relation("RecruiterApprover")
  notificationsCreated        Notification[]               @relation("NotificationAuthor")
  hackathonRemovalsPerformed  HackathonRemoval[]           @relation("HackathonRemover")

  // hire — Scout engagements, requests and availability
  virtualCandidateRequests   VirtualCandidateRequest[]       @relation("VirtualCandidateRequester")
  virtualCandidatesAssigned  VirtualCandidateRequest[]       @relation("VirtualCandidateAssignee")
  virtualCandidatesLinked    VirtualCandidateRequest[]       @relation("VirtualCandidateLinked")
  virtualCandidatesConverted VirtualCandidate[]              @relation("VirtualCandidateConverted")
  virtualCandidateEvents     VirtualCandidateEvent[]         @relation("VirtualCandidateActor")
  talentRequests             TalentRequest[]
  engagementsAsRecruiter     TalentEngagementRequest[]       @relation("RecruiterEngagements")
  engagementsAsCandidate     TalentEngagementRequest[]       @relation("CandidateEngagements")
  candidateMatches           TalentRequestMatch[]            @relation("CandidateMatches")
  engagementMessages         TalentEngagementMessage[]
  /// T-232 — recruiter ↔ candidate outreach (plan 130).
  outreachThreadsAsRecruiter OutreachThread[]                @relation("OutreachThreadsAsRecruiter")
  outreachThreadsAsCandidate OutreachThread[]                @relation("OutreachThreadsAsCandidate")
  outreachMessagesAuthored   OutreachMessage[]               @relation("OutreachMessagesAuthored")
  /// Plan 120 — recruiter detail views / resume unlocks on this candidate.
  profileEvents              CandidateProfileEvent[]
  /// Plan 121 — recruiter-authored assessments (builder drafts).
  assessmentsAuthored        RecruiterAssessment[]           @relation("RecruiterAssessmentsCreated")
  /// Plan 128 (T-244) — recruiter assessments assigned to this candidate.
  assessmentAssignments      RecruiterAssessmentAssignment[] @relation("AssessmentAssignee")

  // credits (T-228) — the recruiter credit ledger. Restrict, like pointsLedger:
  // financial history outlives the convenience of deleting a row.
  recruiterCreditTransactions CreditTransaction[] @relation("RecruiterCreditTransactions")
  candidateCreditTransactions CreditTransaction[] @relation("CandidateCreditTransactions")

  @@index([deletedAt, createdAt(sort: Desc)])
  @@index([disabledAt])
  @@index([createdAt(sort: Desc)])
}

enum LegalDocument {
  TERMS
  PRIVACY
}

/// Versioned acceptance of Terms / Privacy (signup funnels + pre-auth cohort apps).
model LegalConsent {
  id         String        @id @default(cuid())
  userId     String?
  email      String?
  document   LegalDocument
  version    String
  source     String
  ip         String?
  userAgent  String?
  acceptedAt DateTime      @default(now())
  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, document, acceptedAt(sort: Desc)])
  @@index([email, acceptedAt(sort: Desc)])
  @@index([source, acceptedAt(sort: Desc)])
}

enum DataRightsRequestType {
  ACCESS
  CORRECTION
  ERASURE
  OTHER
}

enum DataRightsRequestStatus {
  PENDING
  DONE
  REJECTED
}

/// Marketing-email opt-in, presented on every signup funnel.
///
/// Deliberately its own model rather than a StudentProfile column: the
/// checkbox also appears on the workshop, hackathon, program and cohort
/// funnels, where no StudentProfile exists. Keyed on `email` rather than
/// `userId` because the cohort funnels write to Supabase and may have no
/// User row at all.
///
/// `subscribed` is the source of truth for whether to send — unsubscribing
/// flips it to false and stamps `unsubscribedAt`, keeping the record so a
/// later opt-in is distinguishable from a never-subscribed address.
model NewsletterSubscription {
  id             String    @id @default(cuid())
  /// Not unique: the same person may subscribe a second address through a
  /// different funnel (e.g. a workshop signup with a work email).
  userId         String?
  email          String    @unique
  subscribed     Boolean   @default(true)
  /// Which funnel the opt-in came from (register, workshop, hackathon, …).
  source         String
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([subscribed, subscribedAt(sort: Desc)])
  @@index([userId])
}

model DataRightsRequest {
  id        String                  @id @default(cuid())
  userId    String?
  email     String
  type      DataRightsRequestType
  message   String?
  status    DataRightsRequestStatus @default(PENDING)
  createdAt DateTime                @default(now())
  user      User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([email, createdAt(sort: Desc)])
}

/// One-time phone OTP verification record (MSG91 OTP widget).
/// Bridges verification done during registration (before StudentProfile exists)
/// to `completeRegistration`, and stores the verified state for existing users.
model PhoneVerification {
  id         String    @id @default(cuid())
  userId     String    @unique
  phone      String // E.164, e.g. +919876543210
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum RedemptionStatus {
  PENDING
  SHIPPED
  FULFILLED
  CANCELLED
}

model MarketplaceItem {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  description String
  costSP      Int
  imagePath   String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  /// Sizes the student must pick from when redeeming, e.g.
  /// ["S", "M", "L", "XL", "XXL"] on the Classic Tee. Empty — the default, and
  /// the case for most of the catalog — means the item has no size and the
  /// redeem dialog shows no size control.
  ///
  /// Seeded from `prisma/content/marketplace.json`, so adding sizes to another
  /// item is a JSON edit plus `npm run db:seed:marketplace`, not a migration.
  /// `redeemItem` validates the chosen size against THIS list at redeem time
  /// and `Redemption.selectedSize` stores the answer, so changing the list
  /// later never rewrites or invalidates an order already placed.
  sizeOptions String[] @default([])

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  redemptions Redemption[]

  @@index([active, sortOrder])
}

model Redemption {
  id        String @id @default(cuid())
  userId    String
  itemId    String
  costSP    Int
  itemTitle String

  /// The size chosen at redeem time, or null when the item has none (and for
  /// every redemption predating sizes). Copied from the item's `sizeOptions`
  /// rather than referencing them, for the same reason `itemTitle` and `costSP`
  /// are copied: the order must still read correctly after the catalog moves on.
  selectedSize String?

  status RedemptionStatus @default(PENDING)

  /// The address as one printable block. Still the only field guaranteed to be
  /// populated: redemptions made before the structured fields existed have this
  /// and nothing else, so admin UI and shipping labels read THIS, not the parts.
  /// New redemptions compose it from the structured columns below.
  shippingAddress String
  recipientPhone  String

  /// Structured address, captured since the redeem dialog replaced its free-form
  /// textarea. Nullable because legacy rows have no parts to fill them with —
  /// they are not optional for new writes, which always set every one except
  /// `addressLine2`. `state` is a name from `src/data/india-locations.ts`;
  /// `city` is free text (no city list is complete) and `country` is "India",
  /// the only destination we ship to today.
  recipientName String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  pincode       String?
  country       String?

  trackingNote String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  item         MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model RecruiterReview {
  id                    String               @id @default(cuid())
  userId                String               @unique
  targetRole            String?
  skillGroups           Json?
  education             Json?
  certifications        Json?
  languagesSpoken       String[]             @default([])
  achievements          String[]             @default([])
  headline              String?
  summary               String?
  experience            Json?
  projects              Json?
  communicationScore    Int?
  programmingScore      Int?
  behaviorScore         Int?
  communicationFeedback String?
  programmingFeedback   String?
  behaviorFeedback      String?
  codingChallenges      Json?
  strengths             String[]             @default([])
  areasForGrowth        String[]             @default([])
  recommendation        RecommendationLevel?
  assessmentDate        DateTime?
  interviewerName       String?
  challengeRound        String?
  abtalksId             String?
  logistics             Json?
  compensation          Json?
  adminNote             String?
  isPublished           Boolean              @default(false)
  shareToken            String?              @unique
  reviewedByAdminId     String?
  reviewedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shareToken])
}

enum RecommendationLevel {
  STRONGLY_RECOMMEND
  RECOMMEND
  NEUTRAL
  DO_NOT_RECOMMEND
}

enum JobType {
  FULL_TIME
  INTERNSHIP
  CONTRACT
  PART_TIME
}

/// T-245 recruiter job lifecycle. Default PUBLISHED so historical rows added
/// before this column existed stay live; recruiter-created rows pass DRAFT
/// explicitly. `isOpen` is kept in sync (PUBLISHED → true, else false) so
/// legacy readers continue to work.
enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum JobWorkMode {
  REMOTE
  HYBRID
  ONSITE
}

model Job {
  id               String           @id @default(cuid())
  title            String
  company          String
  location         String?
  workMode         JobWorkMode?
  type             JobType          @default(FULL_TIME)
  description      String
  skills           String[]         @default([])
  /// Years of experience the role asks for. Null means the posting does not
  /// say, which is every job written before this column existed — the card
  /// shows no pill rather than inventing a "0+". Named to match
  /// `TalentRequest.minExperience`, the recruiter-side request model, rather
  /// than `yearsExperience`, which is already taken on the candidate side for
  /// a derived value.
  minExperience    Int?
  applyExternalUrl String?
  isOpen           Boolean          @default(true)
  status           JobStatus        @default(PUBLISHED)
  createdByAdminId String?
  recruiterId      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  publishedAt      DateTime?
  closedAt         DateTime?
  applications     JobApplication[]
  createdByAdmin   User?            @relation("JobCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  recruiter        User?            @relation("RecruiterJobs", fields: [recruiterId], references: [id], onDelete: SetNull)
  skillLinks       JobSkill[]

  @@index([isOpen, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([recruiterId, createdAt(sort: Desc)])
}

/// T-246 candidate application status. Default APPLIED; recruiter workflow
/// for the remaining transitions ships in a later ticket.
enum JobApplicationStatus {
  APPLIED
  REVIEWING
  ACCEPTED
  REJECTED
}

model JobApplication {
  id          String               @id @default(cuid())
  jobId       String
  userId      String // candidateId alias — one User.id per candidate
  status      JobApplicationStatus @default(APPLIED)
  resumeUrl   String?
  coverLetter String?
  note        String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt
  job         Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([jobId])
}

model AdminAction {
  id             String   @id @default(cuid())
  /// Snapshot of who acted. No FK — must survive actor deletion (self-delete).
  actorUserId    String
  adminUserId    String?
  targetUserId   String?
  entityType     String?
  entityId       String?
  previousState  Json?
  newState       Json?
  organizationId String?
  actionType     String
  metadata       Json?
  reason         String?
  createdAt      DateTime @default(now())
  admin          User?    @relation("AdminActor", fields: [adminUserId], references: [id], onDelete: SetNull)
  target         User?    @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId])
  @@index([createdAt])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
}

model AdminRemark {
  id            String   @id @default(cuid())
  studentUserId String
  adminUserId   String
  body          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  student       User     @relation("RemarkStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  admin         User     @relation("RemarkAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId, createdAt(sort: Desc)])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum Role {
  STUDENT
  ADMIN
  RECRUITER
}

enum SubmissionStatus {
  ON_TIME
  LATE
}

enum CertificateType {
  CLAUDE_CHALLENGE
  HACKATHON
  COHORT
  WORKSHOP
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum ProgramCohortStatus {
  DRAFT
  ENROLLING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ProgramMemberStatus {
  APPLIED
  WAITLISTED
  ENROLLED
  COMPLETED
  DROPPED
}

enum ProgramLanguage {
  PYTHON
  SQL
  JAVASCRIPT
  YAML
}

enum ProgramEntrySection {
  APTITUDE
  TECHNICAL
}

enum ProgramInterviewStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ProgramProjectStatus {
  SUBMITTED
  GRADED
}

enum ProgramMissionType {
  CODE_SPRINT
  SHIP_IT
  DATA_ROOM
  PROMPT_FORGE
  BOSS_BUILD
}

enum ProgramDayState {
  LOCKED
  AVAILABLE
  PASSED
  SKIPPED
}

model ProgramCohort {
  id                 String                @id @default(cuid())
  name               String
  joinCode           String                @unique
  startsAt           DateTime // IST Day-1 anchor
  endsAt             DateTime // hard end — scores freeze after this
  capacity           Int                   @default(100)
  status             ProgramCohortStatus   @default(DRAFT)
  requiresJoinCode   Boolean               @default(true) // false = open enrollment, no code
  resultsPublishedAt DateTime?
  createdAt          DateTime              @default(now())
  entryAttempts      ProgramEntryAttempt[]
}

model ProgramModule {
  id       String       @id @default(cuid())
  number   Int          @unique // 1..4
  title    String
  subtitle String
  color    String
  startDay Int
  endDay   Int
  days     ProgramDay[]
}

model ProgramDay {
  id               String                   @id @default(cuid())
  moduleId         String
  dayNumber        Int                      @unique // 1..30
  title            String
  missionType      ProgramMissionType
  briefMd          String // the mission briefing: realistic enterprise scenario, markdown
  assetsJson       Json? // client-safe assets: datasets (CSV text), API specs, starter files
  missionSpec      Json // SERVER-ONLY verification spec (see §6b) — never serialized to client
  starterCode      String?
  language         ProgramLanguage? // for CODE_SPRINT / DATA_ROOM workbench default
  objectives       String[]                 @default([])
  tools            String[]                 @default([])
  estimatedMin     Int                      @default(60)
  missionPoints    Int                      @default(12)
  isProjectDay     Boolean                  @default(false) // days 7, 14, 21, 30 (BOSS_BUILD)
  module           ProgramModule            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  conceptQuestions ProgramConceptQuestion[]
  videos           ProgramVideo[]
}

model ProgramConceptQuestion {
  id           String     @id @default(cuid())
  dayId        String
  order        Int
  question     String
  options      String[] // exactly 4
  correctIndex Int
  explanation  String
  day          ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@unique([dayId, order])
}

model ProgramConceptAttempt {
  id                  String            @id @default(cuid())
  memberId            String
  /// Wave 2 additive. Backfilled `pe_pm_<memberId>`. FK added after parity.
  programEnrollmentId String
  dayNumber           Int
  questionIds         Json // string[] — 3 sampled ids
  answers             Json?
  score               Int               @default(0) // 0..3
  createdAt           DateTime          @default(now())
  programEnrollment   ProgramEnrollment @relation(fields: [programEnrollmentId], references: [id], onDelete: Restrict)

  @@unique([memberId, dayNumber]) // ONE attempt — it's a warm-up, not a gate
  @@index([programEnrollmentId])
}

model ProgramEntryQuestion {
  id           String              @id @default(cuid())
  section      ProgramEntrySection
  question     String
  options      String[]
  correctIndex Int
  explanation  String
  active       Boolean             @default(true)

  @@index([section, active])
}

model ProgramEntryAttempt {
  id             String        @id @default(cuid())
  userId         String
  cohortId       String
  attemptNumber  Int
  questionIds    Json
  answers        Json?
