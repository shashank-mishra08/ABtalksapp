  pointsAwarded       Int
  aiFeedback          String?
  createdAt           DateTime
  activityAttemptId   String?
  archivedAt          DateTime @default(now())

  @@index([programEnrollmentId, dayNumber])
  @@index([memberId, dayNumber])
}

/// Immutable 078 historical archive. Public verify uses Credential.
model HistoricalCertificate {
