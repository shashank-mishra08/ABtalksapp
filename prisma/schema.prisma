// ─── Hire / Scout (evidence-based matching) ─────────────────────────────────

enum TalentRequestStatus {
  DRAFT
  ACTIVE
  MATCHED
  FULFILLED
  CLOSED
}

enum TalentWorkMode {
  ONSITE
  HYBRID
  REMOTE
  FLEXIBLE
}

enum TalentEmploymentType {
  FULL_TIME
  CONTRACT
  INTERNSHIP
  PART_TIME
  FREELANCE
}

enum TalentSeniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  LEAD
}

enum TalentMatchTier {
  STRONG
  PARTIAL
  NONE
}

/// Recruiter requirement gathered by Scout. Survives zero matches (demand signal).
model TalentRequest {
  id                       String                    @id @default(cuid())
  recruiterUserId          String
  status                   TalentRequestStatus       @default(DRAFT)
  title                    String
  seniority                TalentSeniority?
  openings                 Int                       @default(1)
  mustHaveStack            String[]                  @default([])
  niceToHaveStack          String[]                  @default([])
  /// Ordered evidence dimensions; reweights scoring (e.g. consistency, projects).
  evidencePriority         String[]                  @default([])
  salaryMin                Int?
  salaryMax                Int?
  salaryCurrency           String                    @default("INR")
  salaryPeriod             String                    @default("ANNUAL")
  workMode                 TalentWorkMode?
  locationCity             String?
  employmentType           TalentEmploymentType?
  noticePeriodDays         Int?
  minExperience            Int?
  maxExperience            Int?
  requiresDegree           Boolean                   @default(false)
  /// Free-form extras Scout captured; never used for matching.
  extra                    Json?
  alertWhenAvailable       Boolean                   @default(false)
  /// The recruiter's own label for this piece of work, e.g. "Senior Backend
  /// Engineer - Delhi NCR". Distinct from `title`, which is the role being
  /// hired for: two searches for the same role are otherwise indistinguishable
  /// in a list. Nullable so existing rows need no invented value; the UI falls
  /// back to `title` when it is null.
  name                     String?
  /// When this recruiter last opened the request.
  ///
  /// This is what `TalentRequestMatch.firstSeenAt` is compared against to draw
  /// the "new since your last visit" badge - firstSeenAt alone has nothing to
  /// measure from. A request has exactly one recruiter today
  /// (`recruiterUserId`), so one column is enough; if organisation-wide
  /// projects arrive this must become a per-(recruiter, request) row.
  lastViewedAt             DateTime?
  /// Filed away by the recruiter. Deliberately NOT a TalentRequestStatus value:
  /// status says where the request is in its lifecycle, this says the recruiter
  /// put it aside, and a timestamp also records when.
  archivedAt               DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  recruiter                User                      @relation(fields: [recruiterUserId], references: [id], onDelete: Cascade)
  messages                 TalentRequestMessage[]
  matches                  TalentRequestMatch[]
  engagements              TalentEngagementRequest[]
  virtualCandidates        VirtualCandidate[]        @relation("VirtualCandidateOrigin")
  virtualCandidateRequests VirtualCandidateRequest[] @relation("VirtualCandidateRequestBrief")
  /// Plan 133 — every search run inside this project, and the assessments filed under it.
  sessions                 TalentSearchSession[]
  assessmentLinks          TalentProjectAssessment[]

  @@index([recruiterUserId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model TalentRequestMessage {
  id        String               @id @default(cuid())
  requestId String
  role      String // "user" | "assistant"
  content   String
  options   Json?
  createdAt DateTime             @default(now())
  /// Plan 133. The search session this turn belongs to. Null only on rows
  /// written before sessions existed, until `ensureLegacySession` files them
  /// under Session 1.
  sessionId String?
  request   TalentRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  session   TalentSearchSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([sessionId, createdAt])
}

/// Plan 133. One search inside a project (TalentRequest): its own prompt,
/// brief, chat and results. "New search" adds one; it never replaces another.
///
/// The shortlist is NOT here — decisions stay project-level on
/// TalentRequestMatch, so a candidate shortlisted in session 1 is still
/// shortlisted when session 2 shows them.
model TalentSearchSession {
  id                 String    @id @default(cuid())
  requestId          String
  /// 1, 2, 3… within the project. Unique, which is what makes creating one
  /// (and materializing a legacy Session 1) safe under concurrency.
  ordinal            Int
  /// The recruiter's opening prompt for this search, trimmed.
  title              String
  /// This session's brief (JobSpec). The project's TalentRequest columns
  /// mirror the latest session's brief for existing readers.
  spec               Json?
  /// Ordered candidates from this session's last run.
  resultCandidateIds String[]  @default([])
  /// Per-candidate scoring from this session's last run, so a later session
  /// re-scoring the same person does not rewrite what this one showed.
  resultSnapshot     Json?
  overallGap         String?
  matchCount         Int?
  lastRunAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  request  TalentRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  messages TalentRequestMessage[]

  @@unique([requestId, ordinal])
  @@index([requestId, createdAt(sort: Desc)])
}

/// Plan 133. Files a recruiter assessment under one project.
///
/// A separate table so the assessment system (T-243/T-244) is not modified:
/// an assessment with no row here is "Unassigned", exactly as every
/// assessment was before this existed. At most one project per assessment.
model TalentProjectAssessment {
  id             String   @id @default(cuid())
  requestId      String
  assessmentId   String   @unique
  linkedByUserId String
  createdAt      DateTime @default(now())

  request    TalentRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assessment RecruiterAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

/// A recruiter's triage verdict on ONE match.
///
/// Deliberately narrow: three values, about a candidate's fit for this search.
/// It is not the hiring pipeline - `PipelineStage` on TalentListItem owns that
/// once a candidate is on a talent list. Keeping them apart is a decision
/// pending sign-off; see docs/plans/113-A-schema-review-sohail.md, question 1.
enum TalentMatchDecision {
  UNDECIDED
  SHORTLISTED
  REJECTED
}

/// Scored candidate snapshot frozen at match time for auditability.
///
/// Keyed on `candidateUserId`, because a candidate is a person and not a cohort
/// row. This carried `programMemberId` + `studentUserId` + `source` — three
/// columns doing one column's job, which is what happens when the identity is a
/// membership. `programMemberId` survives as PROVENANCE ONLY: it records which
/// cohort row the evidence was read from, has no foreign key, and must never be
/// used to identify or look up the candidate.
model TalentRequestMatch {
  id                  String                @id @default(cuid())
  requestId           String
  candidateUserId     String
  /// Provenance only. No FK, never an identity. See the note above.
  programMemberId     String?
  score               Int
  tier                TalentMatchTier
  scoreBreakdown      Json
  evidence            Json
  rationale           String?
  gaps                String[]              @default([])
  availabilityUnknown Boolean               @default(true)
  source              TalentCandidateSource @default(PROGRAM)
  /// The first time this candidate appeared on this request.
  ///
  /// `createdAt` cannot serve: the match run used to delete every row and
  /// recreate it, so createdAt meant "last run". The run is an upsert now
  /// (see runMatchAction) and this column is never written on update, which is
  /// what makes "new since your last visit" answerable.
  firstSeenAt         DateTime              @default(now())
  /// When the recruiter first opened this candidate on this request. Null IS
  /// the meaning "not yet viewed", so it is nullable with no default.
  viewedAt            DateTime?
  decision            TalentMatchDecision   @default(UNDECIDED)
  createdAt           DateTime              @default(now())
  request             TalentRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  candidate           User                  @relation("CandidateMatches", fields: [candidateUserId], references: [id], onDelete: Cascade)

  /// A candidate appears at most once per request. This is what the match run
  /// upserts on, and it is the one part of this migration that can FAIL on
  /// existing data - check for duplicate pairs before applying.
  @@unique([requestId, candidateUserId])
  @@index([requestId, score(sort: Desc)])
  @@index([candidateUserId])
}

enum HackathonEntryType {
  SOLO
  TEAM
}

model HackathonTeam {
  id           String                 @id @default(cuid())
  eventId      String                 @default("legacy")
  entryType    HackathonEntryType
  teamName     String?
  teamCode     String
  createdAt    DateTime               @default(now())
  participants HackathonParticipant[]
  submission   HackathonSubmission?

  @@unique([eventId, teamCode])
  @@index([eventId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model HackathonParticipant {
  id             String   @id @default(cuid())
  eventId        String   @default("legacy")
  teamId         String
  userId         String
  slotIndex      Int
  isLeader       Boolean  @default(false)
  fullName       String
  email          String
  phone          String
  college        String
  graduationYear Int
  sourceSlug     String?
  createdAt      DateTime @default(now())

  team HackathonTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@unique([teamId, slotIndex])
  @@index([eventId, teamId])
  @@index([userId])
  @@index([teamId])
  @@index([sourceSlug])
}

enum HackathonRemovalActor {
  LEADER
  ADMIN
}

/// Append-only log of hackathon team removals. The `HackathonParticipant` row is
/// hard-deleted on removal — that frees `userId @unique` (so the person can
/// register again, including back into the same team) and frees the slot. This
/// table preserves who was removed, by whom, and their original share-link
/// attribution so a rejoin keeps its `sourceSlug`.
model HackathonRemoval {
  id               String                @id @default(cuid())
  eventId          String                @default("legacy")
  teamId           String
  teamCode         String
  teamName         String?
  userId           String
  fullName         String
  email            String
  phone            String
  college          String
  graduationYear   Int
  slotIndex        Int
  sourceSlug       String?
  originalJoinedAt DateTime
  removedByUserId  String?
  removedByRole    HackathonRemovalActor
  reason           String?
  createdAt        DateTime              @default(now())

  user      User  @relation("HackathonRemoved", fields: [userId], references: [id], onDelete: Cascade)
  removedBy User? @relation("HackathonRemover", fields: [removedByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, userId, createdAt(sort: Desc)])
  @@index([eventId, teamId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([teamId])
  @@index([createdAt(sort: Desc)])
}

enum HackathonVideoEmployment {
  LEARNER
  WORKING
}

/// VideoThon (video editors hackathon) registration. One row per user per event.
/// Independent from `HackathonParticipant` which is coder-shaped (college,
/// graduationYear). Video-track registrations are solo-only by design, so
/// there is no `HackathonTeam` sibling — the row itself is the entry.
///
/// `currentCtc` is a free-text field so it can hold a rupees-per-year number,
/// the literal string "NA", or an empty string (the form only requires it when
/// employment=WORKING but accepts "NA" as a valid answer). `portfolioUrl` is
/// any `https://` URL — Google Drive, Behance, YouTube, personal site.
///
/// Reads through `src/features/hackathon-video/*`, never direct Prisma calls
/// outside that folder.
model HackathonVideoRegistration {
  id               String                   @id @default(cuid())
  eventId          String
  userId           String
  fullName         String
  email            String
  phoneCountryCode String // e.g. "+91"
  phoneNumber      String // digits only, no formatting
  city             String
  state            String? // Indian state / UT; null on rows created before it was asked
  employment       HackathonVideoEmployment
  currentCtc       String?
  portfolioUrl     String
  sourceSlug       String?

  // Submission fields — populated during the submission window, null until
  // the participant saves their entry. VideoThon is solo-only so there is
  // no separate submission table; one row per participant, one lifecycle.
  submissionUrl       String?
  submissionNotes     String?
  submissionUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("HackathonVideoRegistrant", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([sourceSlug])
}

/// Singleton (id always 1) — event-wide config editable from /admin/hackathon.
model HackathonEvent {
  id               Int      @id @default(1)
  problemStatement String?
  updatedAt        DateTime @updatedAt
}

/// The hackathon briefs rendered on /hackathon/submission. Content lives in the DB,
/// not in hackathon-config.ts, so it can be edited without a redeploy.
///
/// CONVENTION: the FIRST LINE of `statement` is the one-line tagline shown on the
/// collapsed card. Everything after the first newline is the expanded body. An empty
/// `statement` means "no tagline, body not written yet".
///
/// `id` has no DB default on purpose — rows are seeded with stable slugs
/// (`brief-1`, `brief-2`, `brief-3`) by prisma/seed-hackathon-problems.ts.
model HackathonProblem {
  id          String                @id
  title       String
  statement   String
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  submissions HackathonSubmission[]

  @@index([sortOrder])
}

/// One entry per team (`teamId` is unique) — a team answers exactly ONE brief.
/// Re-saving overwrites in place; there is no edit history, by design.
/// `liveUrl` and `aiLogUrl` are NOT NULL in the DB: store "" for "not provided yet",
/// never null.
model HackathonSubmission {
  id        String   @id @default(cuid())
  teamId    String   @unique
  problemId String?
  repoUrl   String
  liveUrl   String
  aiLogUrl  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team    HackathonTeam     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  problem HackathonProblem? @relation(fields: [problemId], references: [id])

  @@index([problemId])
}

/// Named share links for hackathon attribution (`?s=<slug>`). Inserted by hand.
model HackathonLink {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  note      String?
  createdAt DateTime @default(now())
}

/// Every workshop / webinar signup — all events in one table, one row per
/// (event, person). Google sign-in is mandatory, so `userId` is REQUIRED: every
/// registration belongs to a real User, exactly like HackathonParticipant.
///
/// Unlike the hackathon, `userId` is NOT globally unique — workshops run weekly
/// and the same person is expected to register again for each one. The scoped
/// `@@unique([eventId, userId])` allows that while blocking a double signup for
/// the same workshop.
///
/// `eventId` matches WorkshopEvent.id in src/components/workshop/events-data.ts.
/// Events stay code-defined — they carry marketing copy and Lucide icon
/// references — so a new workshop needs an EVENTS entry and nothing else here.
model WorkshopRegistration {
  id             String   @id @default(cuid())
  eventId        String
  userId         String
  /// Snapshot of what they submitted for THIS workshop. Kept on the row rather
  /// than read from the profile because a workshop-only attendee has a User but
  /// no StudentProfile (that requires a domain + referralCode they never chose).
  name           String
  email          String
  phone          String
  /// "Student" or "Professional" — drives which profile fields are written back.
  role           String
  /// College (students) or company (professionals).
  organization   String?
  graduationYear Int?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // No separate [eventId, email] constraint: User.email is already unique and
  // userId is required, so this single constraint fully prevents duplicates.
  @@unique([eventId, userId])
  @@index([eventId, createdAt(sort: Desc)])
  @@index([userId])
}

// NOTE: `workshop_config` deliberately stays in Supabase — only registrations
// migrated. See src/lib/workshop-supabase.ts for the config reader.

/// Which product track an event belongs to. Drives the calendar tile colour
/// and what a click does — only `WORKSHOP` entries open the replay modal.
///
/// Deliberately its own enum. `NotificationCategory` carries the same four
/// values but is a LOCKED enum in the notification module, and `CertificateType`
/// is certificate semantics. Neither may be reused here — see plan 163 §5.
enum WorkshopTrack {
  WORKSHOP
  HACKATHON
  COHORT
  CHALLENGE
}

/// A workshop or event on the public calendar. Plan 163.
///
/// Replaces the hardcoded `EVENTS` array in
/// `src/components/workshop/events-data.ts`, so a new workshop is an admin
/// action rather than a code change and a deploy.
///
/// **`id` is the roster key.** `WorkshopRegistration.eventId` points here by
/// string, with no foreign key (366 rows predate this table). New ids follow
/// `workshop-YYYY-MM-DD`; the ported ones keep whatever they already were,
/// including three that predate that convention. It is never editable — a
/// changed id silently detaches a roster.
model WorkshopEvent {
  id               String        @id
  /// The calendar day. Day-precision: comparisons are on the IST calendar day,
  /// which is what keeps an event under "Upcoming" for the whole of its own day.
  date             DateTime
  /// Display string as written, e.g. "7:00 PM IST" or "Day 1". Not parsed.
  timeLabel        String
  title            String
  description      String
  host             String
  location         String
  tag              String
  accent           String
  /// A lucide icon NAME, never a component: a component cannot be stored, and
  /// this repo forbids passing one across the Server→Client boundary. The
  /// name→component map lives in the client.
  iconName         String
  track            WorkshopTrack
  /// A `/public` path on ported rows; a Blob URL once phase 3 lands. Both are
  /// just URLs to an `<img>`, so one column serves both.
  posterUrl        String?
  /// Explicit kill switch. False closes signups without deleting the session.
  registrationOpen Boolean       @default(true)
  /// Its card links straight to the registration form.
  register         Boolean       @default(false)
  /// For events living outside the workshop funnel (e.g. the hackathon).
  externalHref     String?
  ctaLabel         String?
  /// Replay and modal content — all arrive after the session runs.
  youtubeId        String?
  duration         String?
  titleAccents     String[]      @default([])
  takeaways        String[]      @default([])
  topics           String[]      @default([])
  /// `{ label, href, kind }[]`.
  resources        Json?
  /// Session length in minutes; absent falls back to DEFAULT_DURATION_MIN.
  durationMinutes  Int?
  /// Null until an admin publishes. Nothing unpublished is ever public.
  publishedAt      DateTime?
  /// Set on all ten ported events. Archived rows keep their registrations and
  /// stay in the admin console, and are excluded from every public surface.
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([date(sort: Desc)])
  @@index([publishedAt, archivedAt, date])
}

/// General AB Talks AI Interview — a standardized, comparable talent signal
/// built from a candidate's own verified challenge work. Separate from
/// `ProgramInterview` (the 31-day AI Cohort exit interview), which is unrelated
/// and must keep working independently.
model GeneralInterview {
  id                  String @id @default(cuid())
  memberId            String
  /// Wave 2 additive. Backfilled `pe_pm_<memberId>`. FK added after parity.
  programEnrollmentId String

  /// Which standardized question bank this interview ran. A member may hold at
  /// most ONE completed interview per blueprint — enforced by a partial unique
  /// index on COMPLETED rows (see the migration), so abandoned and invalid
  /// attempts never consume the milestone.
  blueprint InterviewBlueprint
  status    GeneralInterviewStatus @default(NOT_STARTED)

  /// Frozen at session start: planned questions, rubric snapshot, context summary.
  /// The rubric snapshot keeps historical scores interpretable if weights change.
  plan       Json
  transcript Json?
  /// Merged per-question evidence, keyed by question id.
  evidence   Json?

  /// Authoritative runtime state (question index, follow-up budget, stuck count,
  /// transcript, evidence). Held server-side and never accepted from the client:
  /// a candidate who could edit it could skip questions or inject evidence and
  /// manipulate their own score. `transcript`/`evidence` above are read-optimized
  /// projections of this, written from the same object.
  state Json?

  /// Cohort day numbers this blueprint covered, frozen at open for provenance:
  /// DAY_15 → 1..15, DAY_31 → 1..31. Never used to decide eligibility — that is
  /// recomputed from ProgramMissionSubmission at request time.
  scopeDays Int[] @default([])

  conceptualScore     Int?
  practicalScore      Int?
  problemSolvingScore Int?
  technicalDepthScore Int?
  communicationScore  Int?
  overallScore        Int?
  summary             String?

  durationSec   Int?
  invalidReason String?

  startedAt   DateTime?
  endedAt     DateTime?
  evaluatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  programEnrollment ProgramEnrollment @relation(fields: [programEnrollmentId], references: [id], onDelete: Restrict)
  turns             InterviewTurn[]
  report            InterviewReport?

  @@index([memberId, status])
  @@index([memberId, blueprint])
  @@index([programEnrollmentId])
}

/// One candidate answer and what the system made of it.
///
/// `GeneralInterview.state` stays the authoritative RUNTIME blob (it is what a
/// resumed attempt reads); these rows are the durable AUDIT TRAIL. They exist
/// because a report is only defensible if every claim in it can be traced back
/// to a specific answer, and a JSON blob cannot be queried per turn.
model InterviewTurn {
  id          String @id @default(cuid())
  interviewId String

  /// Monotonic within an interview. Ordering is explicit, never inferred from
  /// createdAt — two turns can land inside the same millisecond.
  turnIndex Int

  /// The CORE bank question this turn belongs to. Deep-probe turns carry the
  /// same questionId with a higher depthLevel, so a question's whole thread is
  /// one query.
  questionId String
  /// CORE | EXTENSION. EXTENSION turns are reported but never scored.
  tier       String
  /// 1 = the banked question, 2+ = an escalation rung.
  depthLevel Int    @default(1)
  /// NEXT_QUESTION | FOLLOW_UP | ESCALATE | REDIRECT | REPEAT | COMPLETE
  action     String

  /// Exactly what the interviewer said and the candidate answered. Stored
  /// verbatim: a report that quotes a paraphrase is not evidence.
  promptText String
  answerText String

  /// AnswerEvidence, Zod-validated on write. Null for REDIRECT/REPEAT turns,
  /// which record no evidence by design.
  evidence Json?

  /// True when a model failure forced the deterministic path — the one flag
  /// that says "read this turn's judgment with suspicion".
  degraded  Boolean  @default(false)
  latencyMs Int?
  createdAt DateTime @default(now())

  interview GeneralInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, turnIndex])
  @@index([interviewId, questionId])
}

/// The generated report for a completed interview.
///
/// One row per interview. Module and competency assessments live INSIDE
/// `report` as validated JSON rather than as their own tables: they are written
/// once, always read together with the report, and never queried independently.
/// Splitting them would buy five joins for one page and nothing else.
model InterviewReport {
  id          String @id @default(cuid())
  interviewId String @unique

  /// Report schema version. Bumped when the shape changes, so an old row stays
  /// readable instead of failing validation after a deploy.
  version Int @default(1)

  /// Denormalized for listing and sorting without parsing the JSON.
  overallScore Int

  /// The full InterviewReport document. Validated by
  /// `interviewReportSchema` on write AND on read.
  report Json

  /// True when the narrative fell back to deterministic text because the model
  /// was unavailable. The scores are unaffected — they are always computed in
  /// code — but the prose is thinner, and a reader deserves to know.
  narrativeDegraded Boolean @default(false)

  generatedAt DateTime @default(now())

  interview GeneralInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

/// One attempt at a mock interview from the interview platform (plan 103).
///
/// SEPARATE FROM `GeneralInterview` ON PURPOSE. A cohort interview is a
/// credential: one completion per member per blueprint, enforced by a partial
/// unique index, gated on passed curriculum days, keyed to `ProgramMember`. A
/// mock interview is practice: open to any registered `User`, unlimited
/// retakes, no eligibility. Sharing one table would mean every schema change
/// made to serve practice puts the credential at risk, and the one-completion
/// index is exactly the guard that would get loosened for the wrong reason.
///
/// Deliberately absent: any unique index on completion. Retakes are the point.
model MockInterview {
  id     String @id @default(cuid())
  /// Direct FK to User — NOT ProgramMember. A mock interview requires only
  /// registration, so it must not depend on cohort enrollment.
  userId String

  /// Resolved against the code registry in `platform/domains.ts`, not a Postgres
  /// enum. Domains are added by authoring a pack, and a migration per domain
  /// would make the catalogue harder to extend than it needs to be. An unknown
  /// slug simply fails to resolve and the attempt cannot start.
  domainSlug  String
  /// The exact pack version asked. Reports cite question ids permanently, so a
  /// stored report is only interpretable alongside this pin.
  packId      String
  packVersion Int

  /// 1-based, per (userId, domainSlug). Computed as max+1 at open.
  attemptNumber Int

  status MockInterviewStatus @default(NOT_STARTED)

  /// Frozen at open: questions, rubric snapshot, sections, capabilities.
  plan       Json
  /// Authoritative runtime state. Never accepted from the client.
  state      Json?
  /// Read-optimized projections of `state`, written from the same object.
  transcript Json?
  evidence   Json?

  /// Declared workspaces, frozen at open. `["VOICE"]` today. A domain-config
  /// change must not add a workspace to a room already running.
  capabilities String[] @default([])

  /// Scores keyed by RUBRIC COMPETENCY ID, as JSON rather than named columns.
  /// `GeneralInterview` uses five fixed columns, which structurally cannot
  /// express a Behavioral or DSA rubric — that constraint is the main reason
  /// this table exists.
  competencyScores Json?
  /// Denormalized for listing and sorting only. Authority lives in the report.
  overallScore     Int?
  summary          String?

  durationSec   Int?
  invalidReason String?

  startedAt   DateTime?
  endedAt     DateTime?
  evaluatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  turns  MockInterviewTurn[]
  report MockInterviewReport?

  @@index([userId, status])
  @@index([userId, domainSlug])
}

/// One answer and what the system made of it. Append-only audit trail.
///
/// The platform's equivalent of `InterviewTurn`, plus the two forward-compatible
/// columns from plan 103 seams 3 and 6. Both are always null in Phase 1: they
/// exist now because adding them later would mean changing the Server Action
/// signature, the graph entry channel and every evidence path in one commit.
model MockInterviewTurn {
  id          String @id @default(cuid())
  interviewId String

  /// Monotonic within an interview. Ordering is explicit, never inferred from
  /// createdAt — two turns can land inside the same millisecond.
  turnIndex Int

  questionId String
  /// Pack section, the platform's grouping unit in place of a cohort module.
  sectionId  String
  /// 1 = the authored question, 2+ = an escalation rung.
  depthLevel Int    @default(1)
  /// NEXT_QUESTION | FOLLOW_UP | ESCALATE | REDIRECT | REPEAT | CLARIFY | COMPLETE
  action     String

  /// Verbatim. A report that quotes a paraphrase is not evidence.
  promptText String
  answerText String

  /// Seam 3: non-text evidence from a future workspace (code, diagram).
  /// Always null in Phase 1.
  artifacts    Json?
  /// Seam 6: client-side behavioural events for later analysis.
  /// Always null in Phase 1.
  clientEvents Json?

  /// AnswerEvidence. Null for REDIRECT/REPEAT turns, which record none by design.
  evidence Json?

  /// True when a model failure forced the deterministic path.
  degraded  Boolean  @default(false)
  latencyMs Int?
  createdAt DateTime @default(now())

  interview MockInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@unique([interviewId, turnIndex])
  @@index([interviewId, questionId])
}

/// The generated report for one completed mock attempt.
///
/// One row per attempt, not per domain: retakes mean "the report for this
/// domain" is ambiguous, so reports are addressed by attempt.
model MockInterviewReport {
  id          String @id @default(cuid())
  interviewId String @unique

  /// Document schema version. Bumped when the shape changes, so an old row
  /// degrades to "unavailable" rather than rendering half a page.
  version Int @default(1)

  /// Denormalized for listing and sorting without parsing the JSON.
  overallScore Int

  /// The full assessment document. Validated on write AND on read.
  report Json

  /// True when the prose fell back to deterministic text because the narrative
  /// model was unavailable. Scores are unaffected — they are always computed in
  /// code — but a reader deserves to know.
  narrativeDegraded Boolean @default(false)

  generatedAt DateTime @default(now())

  interview MockInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
}

enum MockInterviewStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
  /// Technical failure or too little evidence to score. Consumes nothing.
  INVALID
}

/// Standardized cohort question banks. Extensible: a future candidate-specific
/// blueprint is a new enum member, not a new system.
enum InterviewBlueprint {
  /// Cohort days 1–15. Unlocks when every one of those days is PASSED.
  DAY_15
  /// Cohort days 1–31. Unlocks when every one of those days is PASSED.
  DAY_31
}

enum GeneralInterviewStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
  /// Technical failure or invalid session. Never consumes an attempt.
  INVALID
}

enum NotificationAudience {
  ALL
  CHALLENGE
  PROGRAM
  HACKATHON
  /// T-249 follow-up. Every user without RecruiterProfile — the candidate
  /// segment for admin broadcasts that are candidate-specific.
  CANDIDATE
  /// T-249 follow-up. Every user with a RecruiterProfile row. Paired with
  /// system.notice events for workspace-wide admin messages.
  RECRUITER
}

enum NotificationCategory {
  GENERAL
  WORKSHOP
  HACKATHON
  COHORT
  CHALLENGE
}

/// Admin-authored broadcast announcements, pushed from /admin/notifications.
///
/// Automated event notifications (workshops, hackathon milestones, cohort
/// enrolment) are deliberately NOT stored here — they are derived at read time
/// from the code-defined EVENTS / HACKATHON config and ProgramCohort rows in
/// src/features/notification/derive-event-notifications.ts. That keeps read
/// paths write-free and means adding a workshop to events-data.ts needs no
/// database work. See docs/plans/067-notification-bell.md.
model Notification {
  id               String               @id @default(cuid())
  title            String
  body             String?
  /// Internal path ("/hackathon") or absolute URL. Optional.
  href             String?
  category         NotificationCategory @default(GENERAL)
  audience         NotificationAudience @default(ALL)
  publishedAt      DateTime             @default(now())
  /// After this instant the item stops appearing in the bell. Null = no expiry.
  expiresAt        DateTime?
  isActive         Boolean              @default(true)
  createdByAdminId String?
  createdAt        DateTime             @default(now())

  createdByAdmin User? @relation("NotificationAuthor", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([isActive, publishedAt(sort: Desc)])
}

/// Per-user read state for BOTH admin and derived notifications.
///
/// There is no "dismissed" state on purpose: the feed shows only the newest
/// few notifications (NOTIFICATION_FEED_LIMIT), so older ones fall off by
/// themselves and never need removing by hand.
///
/// `notificationKey` is deliberately NOT a foreign key: derived event
/// notifications have no row to point at. Keys are stable and never reused
/// ("admin:<id>", "workshop:<eventId>", "hackathon:kickoff", …).
model NotificationRead {
  id              String   @id @default(cuid())
  userId          String
  notificationKey String
  readAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationKey])
  @@index([userId])
}

/// Per-user transactional notifications (plan 118, T-248). Separate from the
/// broadcast Notification model above — that one has no userId and addresses
/// audiences; this one targets a specific person about a specific entity.
/// Dedupe is enforced by the unique index on dedupeKey.
model UserNotification {
  id              String   @id @default(cuid())
  recipientUserId String
  eventType       String
  title           String
  body            String?
  href            String?
  dedupeKey       String   @unique
  primaryEntityId String?
  metadata        Json?
  createdAt       DateTime @default(now())

  recipient  User                   @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([recipientUserId, createdAt(sort: Desc)])
}

/// Per-channel delivery tracking for UserNotification (plan 118, T-248).
/// At most one row per (notificationId, channel). The state machine is:
/// created → sending → sent | failed. Retry is via the atomic claim pattern
/// (UPDATE … WHERE state IN ('created','failed') RETURNING *).
model NotificationDelivery {
  id             String    @id @default(cuid())
  notificationId String
  channel        String
  state          String    @default("created")
  attemptCount   Int       @default(0)
  lastAttemptAt  DateTime?
  failureReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notification UserNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([state])
}

/// User × event_type × channel preference (plan 118, T-248). Rows are created
/// only when a user explicitly changes a default. Absence = default enabled.
/// channel is always 'email' in this PR — in-app cannot be disabled.
model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  eventType String
  channel   String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  user User @relation("NotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, channel])
}

/// T-250 candidate job alert. Rule-based, not a recommendation engine.
/// Many rows per candidate — each with its own name and criteria. Cap is
/// enforced in the service (not the schema) so it can be raised without a
/// migration. Fanout runs on the FIRST DRAFT→PUBLISHED transition of a Job
/// and dedups per (candidate, job) via UserNotification.dedupeKey — even if
/// several of a candidate's alerts match the same job, they still receive
/// exactly one notification.
model JobAlert {
  id              String       @id @default(cuid())
  candidateUserId String
  name            String       @default("My job alert")
  enabled         Boolean      @default(true)
  skills          String[]     @default([])
  role            String?
  location        String?
  workMode        JobWorkMode?
  opportunityType JobType?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  candidate User @relation("CandidateJobAlerts", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@index([candidateUserId, createdAt(sort: Desc)])
  @@index([enabled])
}

